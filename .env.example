# Which brand folder under /brands to build. Defaults to "lumina".
NEXT_PUBLIC_BRAND=lumina

# Public site URL, used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email (https://resend.com). Leave empty in development:
# messages are then printed to the terminal instead of sent.
# In production, all three are required or the form asks visitors to email directly.
RESEND_API_KEY=
# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=
# Sender address on a domain you have verified in Resend, e.g. "LUMINA Website <website@yourdomain.com>".
CONTACT_FROM_EMAIL=
